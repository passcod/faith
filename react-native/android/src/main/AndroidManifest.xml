<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Android instantiates a content provider before the application's own onCreate, which
          is the earliest point a library can run with a context in hand and the latest that
          still precedes any request. The authority is suffixed with the application id so two
          apps on one device do not collide, as the platform requires.
        -->
        <provider
            android:name="name.passcod.faith.FaithInitProvider"
            android:authorities="${applicationId}.faith-init"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
